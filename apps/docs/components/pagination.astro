---
// oxlint-disable-next-line sonarjs/unused-import -- Referenced in the Astro template below.
import Icon from "blume/components/Icon.astro";
// oxlint-disable-next-line sonarjs/unused-import -- Referenced in the Astro template below.
import { withMountedBase } from "blume/components/islands/base-path";
import type { FlatPage } from "blume/components/layout/nav-utils";
import type { UIStrings } from "blume/core/i18n-ui";

interface Props {
  prev: FlatPage | null;
  next: FlatPage | null;
  strings: UIStrings["page"];
}

const { prev, next, strings } = Astro.props;
const showMainSiteLink = prev === null;
---

{(showMainSiteLink || prev || next) && (
  <nav
    aria-label={strings.pagination}
    class="max-w-content border-border mx-auto mt-12 flex justify-between gap-4 border-t pt-6"
  >
    {showMainSiteLink && (
      <a
        class="rounded-blume border-border text-foreground hover:border-foreground flex max-w-[48%] flex-1 items-center gap-2 border px-4 py-3 transition-colors"
        href="/"
      >
        <Icon class="rtl:-scale-x-100" name="arrow-left" size={16} />
        <span class="min-w-0">
          <span class="text-muted-foreground block text-xs">Back</span>
          <span class="block font-medium max-md:line-clamp-2 max-md:wrap-break-word md:truncate">
            Back to Main Site
          </span>
        </span>
      </a>
    )}
    {prev && (
      <a
        class="rounded-blume border-border text-foreground hover:border-foreground flex max-w-[48%] flex-1 items-center gap-2 border px-4 py-3 transition-colors"
        href={withMountedBase(prev.route)}
      >
        <Icon class="rtl:-scale-x-100" name="arrow-left" size={16} />
        <span class="min-w-0">
          <span class="text-muted-foreground block text-xs">
            {strings.previous}
          </span>
          <span class="block font-medium max-md:line-clamp-2 max-md:wrap-break-word md:truncate">
            {prev.label}
          </span>
        </span>
      </a>
    )}
    {next && (
      <a
        class="rounded-blume border-border text-foreground hover:border-foreground ms-auto flex max-w-[48%] flex-1 items-center justify-end gap-2 border px-4 py-3 text-end transition-colors"
        href={withMountedBase(next.route)}
      >
        <span class="min-w-0">
          <span class="text-muted-foreground block text-xs">
            {strings.next}
          </span>
          <span class="block font-medium max-md:line-clamp-2 max-md:wrap-break-word md:truncate">
            {next.label}
          </span>
        </span>
        <Icon class="rtl:-scale-x-100" name="arrow-right" size={16} />
      </a>
    )}
  </nav>
)}
