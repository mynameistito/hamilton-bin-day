{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@hamilton-bin-day/web#build": {
      "dependsOn": ["@hamilton-bin-day/docs#build"],
      "outputs": ["dist/**"]
    },
    "@hamilton-bin-day/web#dev:site": {
      "with": ["@hamilton-bin-day/docs#dev"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "typecheck": {},
    "check": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:tunnel": {
      "cache": false,
      "persistent": true
    }
  }
}
