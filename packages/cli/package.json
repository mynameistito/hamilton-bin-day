{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "hamilton-bin-day",
  "version": "0.1.10",
  "description": "TypeScript client for Hamilton City Council Fight the Landfill bin-day lookup API.",
  "keywords": [
    "api",
    "bin-day",
    "hamilton",
    "hamilton-city-council",
    "new-zealand",
    "typescript",
    "waste"
  ],
  "homepage": "https://github.com/mynameistito/hamilton-bin-day#readme",
  "bugs": {
    "url": "https://github.com/mynameistito/hamilton-bin-day/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Tito",
    "email": "github@mynameistito.com",
    "url": "https://github.com/mynameistito"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mynameistito/hamilton-bin-day.git"
  },
  "bin": {
    "hamilton-bin-day": "./dist/index.mjs",
    "hcc-bin-day": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "bun run src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "prepack": "bun run check && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
