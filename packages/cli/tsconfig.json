{
  "$schema": "https://www.schemastore.org/tsconfig.json",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "paths": {
      "@/*": ["./src/*"],
      "@root/*": ["./*"]
    },
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["scripts/**/*.ts", "src/**/*.ts"]
}
