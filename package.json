{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@hamilton-bin-day/workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@effect/platform-bun": "4.0.4",
      "@effect/platform-node": "4.0.4",
      "@types/node": "^26.6.5",
      "effect": "4.0.4",
      "typescript": "npm:@typescript/typescript6@^6.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "bins:export": "bun run --filter @hamilton-bin-day/exporter export",
    "bins:sync": "bun apps/web/scripts/sync-hcc-bin-items.ts",
    "check": "ultracite check",
    "ci": "bun run check && bun run typecheck && bun run test && bun run build",
    "changeset": "changeset",
    "changeset-add": "bun ./packages/cli/scripts/changeset-add.ts",
    "deploy": "bun ./scripts/alchemy-command.ts deploy",
    "destroy": "bun ./scripts/alchemy-command.ts destroy",
    "dev": "turbo run dev --filter=@hamilton-bin-day/web",
    "dev:cli": "turbo run dev --filter=hamilton-bin-day",
    "dev:docs": "turbo run dev --filter=@hamilton-bin-day/docs",
    "dev:site": "turbo run dev:site --filter=@hamilton-bin-day/web",
    "dev:web": "turbo run dev --filter=@hamilton-bin-day/web",
    "dev:web:tunnel": "turbo run dev:tunnel --filter=@hamilton-bin-day/web",
    "dev:tunnel": "turbo run dev:tunnel --filter=@hamilton-bin-day/web",
    "fix": "ultracite fix",
    "knip": "bunx knip@latest",
    "prepare": "lefthook install",
    "test": "turbo run test -- --coverage",
    "vapid:generate": "bun run --filter @hamilton-bin-day/web vapid:generate",
    "typecheck": "turbo run typecheck && bunx tsc --project tsconfig.json"
  },
  "dependencies": {
    "@changesets/cli": "^3.0.3",
    "@effect/platform-bun": "catalog:",
    "alchemy": "2.0.0-beta.83",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.1",
    "@types/bun": "1.4.3",
    "@types/node": "catalog:",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "^65.3.4",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-plugin-react-doctor": "^0.9.18",
    "tsdown": "0.23.1",
    "turbo": "^2.11.8",
    "typescript": "catalog:",
    "ultracite": "7.12.4",
    "vitest": "5.0.4"
  },
  "overrides": {},
  "packageManager": "bun@1.4.2"
}
