{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@hamilton-bin-day/workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@effect/platform-bun": "4.0.7",
      "@effect/platform-node": "4.0.7",
      "@types/node": "^26.6.6",
      "effect": "4.0.7",
      "typescript": "npm:@typescript/typescript6@^6.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "bins:export": "bun run --filter @hamilton-bin-day/exporter export",
    "bins:sync": "bun apps/web/scripts/sync-hcc-bin-items.ts",
    "check": "ultracite check",
    "ci": "bun run check && bun run typecheck && bun run test && bun run build && bun run knip",
    "changeset": "changeset",
    "changeset-add": "bun ./packages/cli/scripts/changeset-add.ts",
    "deploy": "bun ./scripts/alchemy-command.ts deploy",
    "destroy": "bun ./scripts/alchemy-command.ts destroy",
    "dev": "turbo run dev --filter=@hamilton-bin-day/web",
    "dev:cli": "turbo run dev --filter=hamilton-bin-day",
    "dev:docs": "turbo run dev --filter=@hamilton-bin-day/docs",
    "dev:site": "turbo run dev:site --filter=@hamilton-bin-day/web",
    "dev:web": "turbo run dev --filter=@hamilton-bin-day/web",
    "dev:web:tunnel": "turbo run dev:tunnel --filter=@hamilton-bin-day/web",
    "dev:tunnel": "turbo run dev:tunnel --filter=@hamilton-bin-day/web",
    "fix": "ultracite fix",
    "knip": "knip",
    "prepare": "lefthook install",
    "test": "turbo run test -- --coverage",
    "vapid:generate": "bun run --filter @hamilton-bin-day/web vapid:generate",
    "typecheck": "turbo run typecheck && tsrs --project tsconfig.json"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@changesets/cli": "^3.0.3",
    "@effect/platform-bun": "catalog:",
    "alchemy": "2.0.0-beta.84",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.5.2",
    "@shadcn/lint": "^0.2.3",
    "@types/bun": "1.4.4",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "5.0.5",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "knip": "6.44.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-plugin-react-doctor": "0.9.18",
    "oxlint-tsgolint": "7.0.2005",
    "tsdown": "0.23.4",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "ultracite": "8.1.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.7",
    "@effect/sql-d1": "4.0.7"
  },
  "packageManager": "bun@1.4.4"
}
