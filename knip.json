{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["alchemy.run.ts", "scripts/**/*.ts"],
      "project": ["*.config.ts", "scripts/**/*.ts"]
    },
    "apps/docs": {
      "entry": ["blume.config.ts"]
    },
    "apps/web": {
      "entry": ["scripts/sync-hcc-bin-items.ts", "src/worker.ts"],
      "project": [
        "scripts/**/*.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.css"
      ]
    },
    "packages/cli": {
      "entry": ["scripts/**/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    }
  }
}
